{
  "opencollection": "1.0.0",
  "info": {
    "name": "Google AdSense Management Accounts Adclients API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://accounts.google.com/o/oauth2/auth",
      "accessTokenUrl": "https://oauth2.googleapis.com/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Adclients",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Google AdSense Management List ad clients",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://adsense.googleapis.com/v2/:parent/adclients",
            "params": [
              {
                "name": "parent",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Lists all ad clients in the specified account."
        }
      ]
    }
  ],
  "bundled": true
}